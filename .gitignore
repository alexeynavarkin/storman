# The SPA bundle is dropped into internal/web/embedded/ during `make build`
# so it can be embed.FS-included. Only placeholder.html is tracked so the
# package compiles on a fresh clone before the UI has been built.
/internal/web/embedded/*
!/internal/web/embedded/placeholder.html

# Local on-premise stack state (data lives under ./data when running compose).
/data/
/tls/
.env
.env.local
.env.*.local
