# Storman on-premise stack — environment template.
# Copy to `.env` and fill in the values. Keep the file out of version control;
# `chmod 600 .env` is recommended since it holds the database password.

# PostgreSQL credentials (used by both the postgres service and storman).
POSTGRES_DB=storman
POSTGRES_USER=storman
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=__CHANGE_ME__

# Docker image to pull. Pin to a specific version in production; `latest` is
# fine for trying things out.
STORMAN_IMAGE=alexnav/storman:latest

# Host:port that exposes the storman container. Default binds to localhost so
# the service is only reachable via the reverse proxy on this host. Set to
# 0.0.0.0:8080 if you intentionally want direct external access (rare).
STORMAN_BIND=127.0.0.1:8080
