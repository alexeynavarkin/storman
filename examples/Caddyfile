# Caddy reverse proxy in front of storman.
#
# Caddy automatically obtains a Let's Encrypt certificate, terminates TLS, and
# forwards X-Forwarded-Proto: https. storman's `web.trust_proxy_headers: true`
# (set by docker-compose env vars on first start) then knows the connection is
# secure and emits Secure cookies.
#
# Replace storman.example.com with your hostname, place this file as
# /etc/caddy/Caddyfile, and run caddy (apt install caddy → systemctl enable
# --now caddy).

storman.example.com {
        encode zstd gzip

        # Storman listens on 127.0.0.1:8080 inside the docker-compose stack.
        # If Caddy runs on a different host than the docker host, point this
        # at the docker host's address (and set STORMAN_BIND=0.0.0.0:8080 in
        # the .env on that host).
        reverse_proxy 127.0.0.1:8080

        # Large uploads — storman supports resumable uploads via tus, but
        # caddy still needs to allow the request body through.
        request_body {
                max_size 0
        }
}
