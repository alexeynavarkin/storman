# Storman on-premise stack — environment template.
#
# Copy this file to `.env` next to docker-compose.yml and fill in the values.
# This is the ONLY file you should need to edit.
#
#     cp .env.example .env
#     chmod 600 .env       # holds the database password
#     docker compose up -d

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=storman
POSTGRES_USER=storman
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=__CHANGE_ME__

# ---- Image ------------------------------------------------------------------
# Pin to a specific version in production; `latest` is fine for trying it out.
STORMAN_IMAGE=ghcr.io/alexnav/storman:latest

# ---- Host binding -----------------------------------------------------------
# host:port pair that exposes the storman HTTP port. Defaults to localhost so
# only a reverse proxy on the same host can reach it. Set to 0.0.0.0:8080 if
# you want direct external access (no TLS — not recommended).
STORMAN_BIND=127.0.0.1:8080
